# Backend-only variables. Never expose these with the VITE_ prefix.
GROQ_API_KEY=your_groq_api_key
# Alternativa aceptada por compatibilidad con tu configuración actual:
# GROQ_API=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Reserved for the future Supabase integration.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Run supabase/schema.sql in the Supabase SQL Editor before using the persistence endpoints.
