# Backend-only variables. Never expose these with the VITE_ prefix.
GROQ_API_KEY=your_groq_api_key
# Alternativa aceptada por compatibilidad con tu configuración actual:
# GROQ_API=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Neon Postgres serverless connection string. Keep it server-only.
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
# Vercel/Neon pueden inyectar alternativamente POSTGRES_URL o NEON_DATABASE_URL.

# Run neon/schema.sql in the Neon SQL Editor before using the persistence endpoints.
